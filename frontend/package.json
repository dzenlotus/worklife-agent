{
  "name": "worklife-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode app --host 127.0.0.1",
    "dev:site": "vite --mode site --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "node --test src/*.test.js",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview --mode app --host 127.0.0.1",
    "preview:site": "vite preview --mode site --host 127.0.0.1"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
