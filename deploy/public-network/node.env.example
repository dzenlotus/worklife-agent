# Copy to .env. Replace the domain and revision before running Compose.
NODE_DOMAIN=replace-with-your-public-domain.invalid
WORKLIFE_REVISION=REPLACE_WITH_REVIEWED_40_CHARACTER_GIT_COMMIT

# caddy:2 is a mutable discovery tag. Pin its verified RepoDigest before launch.
# Example shape only: caddy@sha256:<digest-from-docker-image-inspect>
CADDY_IMAGE=caddy:2

# Local resource policy, never consensus parameters.
# Duty fraction is for the worker's proof loop, not a whole-host CPU quota.
WORKER_CPU_FRACTION=0.25
WORKER_BATCH_ATTEMPTS=250000
WORKER_SYNC_SECONDS=30
